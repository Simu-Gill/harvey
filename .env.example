# Hostinger Cloud MySQL/MariaDB connection.
# Replace every placeholder in the Hostinger Environment Variables screen.
DATABASE_URL="mysql://HOSTINGER_DB_USER:HOSTINGER_DB_PASSWORD@127.0.0.1:3306/HOSTINGER_DB_NAME"

# Public production URL, including https:// and no trailing slash.
NEXTAUTH_URL="https://loans.example.com"

# Generate a unique value with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-production-secret"
